{
  "capabilities": [
    {
      "name": "code.apply_patch",
      "display_name": "Code Apply Patch",
      "description": "Applies a unified diff patch to a file. Supports multi-hunk patches with context validation. Can create new files. Returns a summary of changes applied. Respects .gitignore.",
      "category": "code",
      "input_schema": {
        "properties": {
          "file_path": {
            "description": "The absolute path to the file to patch",
            "type": "string"
          },
          "patch": {
            "description": "Unified diff content with @@ hunk headers. Context lines (space prefix) are validated against the file. Supports multiple hunks.",
            "type": "string"
          }
        },
        "required": [
          "file_path",
          "patch"
        ],
        "type": "object"
      },
      "output_schema": {
        "properties": {
          "created": {
            "type": "boolean"
          },
          "diff": {
            "properties": {
              "lines_added": {
                "type": "integer"
              },
              "lines_removed": {
                "type": "integer"
              },
              "unified": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "file_path": {
            "type": "string"
          },
          "hunks_applied": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "idempotent": false,
      "side_effects": true,
      "is_read_only": false,
      "is_mutating": true,
      "is_concurrency_safe": false,
      "requires_read_before_write": true
    },
    {
      "name": "code.edit",
      "display_name": "Code Edit",
      "description": "Performs targeted string replacement in a file. The old_string must match exactly once (unless replace_all is true). Returns a unified diff of the change. Respects .gitignore.",
      "category": "code",
      "input_schema": {
        "properties": {
          "file_path": {
            "description": "The absolute path to the file to modify",
            "type": "string"
          },
          "new_string": {
            "description": "The replacement text",
            "type": "string"
          },
          "old_string": {
            "description": "The exact text to find and replace",
            "type": "string"
          },
          "replace_all": {
            "default": false,
            "description": "Replace all occurrences (default: false)",
            "type": "boolean"
          }
        },
        "required": [
          "file_path",
          "old_string",
          "new_string"
        ],
        "type": "object"
      },
      "output_schema": {
        "properties": {
          "diff": {
            "properties": {
              "lines_added": {
                "type": "integer"
              },
              "lines_removed": {
                "type": "integer"
              },
              "unified": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "file_path": {
            "type": "string"
          },
          "replacements_made": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "idempotent": false,
      "side_effects": true,
      "is_read_only": false,
      "is_mutating": true,
      "is_concurrency_safe": false,
      "requires_read_before_write": true
    },
    {
      "name": "code.git_diff",
      "display_name": "Code Git Diff",
      "description": "Produces structured diff output from git state. Supports unstaged, staged, and committed (between refs) modes.",
      "category": "code",
      "input_schema": {
        "properties": {
          "file_path": {
            "description": "Optional: scope diff to a single file (relative to repo root)",
            "type": "string"
          },
          "from_ref": {
            "description": "Starting ref for committed mode (e.g., HEAD~3, main)",
            "type": "string"
          },
          "mode": {
            "description": "Diff mode: unstaged (default), staged, or committed",
            "enum": [
              "unstaged",
              "staged",
              "committed"
            ],
            "type": "string"
          },
          "path": {
            "description": "Path to the git repository root",
            "type": "string"
          },
          "to_ref": {
            "description": "Ending ref for committed mode (e.g., HEAD)",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "output_schema": {
        "properties": {
          "files": {
            "type": "array"
          },
          "mode": {
            "type": "string"
          },
          "total_added": {
            "type": "integer"
          },
          "total_files": {
            "type": "integer"
          },
          "total_removed": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "idempotent": true,
      "side_effects": false,
      "is_read_only": true,
      "is_mutating": false,
      "is_concurrency_safe": true,
      "requires_read_before_write": false
    },
    {
      "name": "code.glob",
      "display_name": "Code Glob",
      "description": "Finds files matching a glob pattern, sorted by modification time (most recent first). Respects .gitignore. Supports standard glob syntax: *, **, ?, {a,b}, [abc].",
      "category": "code",
      "input_schema": {
        "properties": {
          "path": {
            "description": "Directory to search in. Defaults to current working directory",
            "type": "string"
          },
          "pattern": {
            "description": "Glob pattern to match files (e.g., '**/*.rs', 'src/**/*.ts')",
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "output_schema": {
        "properties": {
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "total_matches": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "idempotent": true,
      "side_effects": false,
      "is_read_only": true,
      "is_mutating": false,
      "is_concurrency_safe": true,
      "requires_read_before_write": false
    },
    {
      "name": "code.grep",
      "display_name": "Code Grep",
      "description": "Searches file contents using regex patterns. Supports multiple output modes (matching lines, file paths, counts), glob-based file filtering, context lines, and case-insensitive matching. Respects .gitignore.",
      "category": "code",
      "input_schema": {
        "properties": {
          "case_insensitive": {
            "description": "Enable case-insensitive matching. Default: false",
            "type": "boolean"
          },
          "context": {
            "description": "Number of lines before and after each match (content mode only). Overridden by context_before or context_after when specified.",
            "minimum": 0,
            "type": "integer"
          },
          "context_after": {
            "description": "Number of lines to show after each match (content mode only)",
            "minimum": 0,
            "type": "integer"
          },
          "context_before": {
            "description": "Number of lines to show before each match (content mode only)",
            "minimum": 0,
            "type": "integer"
          },
          "glob": {
            "description": "File pattern filter (e.g., '*.rs', '*.{ts,tsx}')",
            "type": "string"
          },
          "max_results": {
            "description": "Maximum number of matching lines/files to return. Default: 250",
            "minimum": 1,
            "type": "integer"
          },
          "output_mode": {
            "description": "Output format. Default: files_with_matches",
            "enum": [
              "content",
              "files_with_matches",
              "count"
            ],
            "type": "string"
          },
          "path": {
            "description": "Directory to search in. Defaults to current working directory",
            "type": "string"
          },
          "pattern": {
            "description": "Regex pattern to search for in file contents",
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "output_schema": {
        "properties": {
          "content": {
            "type": "string"
          },
          "files_searched": {
            "type": "integer"
          },
          "total_matches": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "idempotent": true,
      "side_effects": false,
      "is_read_only": true,
      "is_mutating": false,
      "is_concurrency_safe": true,
      "requires_read_before_write": false
    },
