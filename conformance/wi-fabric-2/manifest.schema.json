{
  "type": "object",
  "properties": {
    "contract": {
      "const": "WI-FABRIC-2"
    },
    "package_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "skeleton"
    },
    "upstream_target": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "AQ-CONT-1"
        },
        "implementation_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "git_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "conformance_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "contract",
        "implementation_commit",
        "git_tree",
        "archive_sha256",
        "source_tree_sha256",
        "conformance_revision"
      ],
      "additionalProperties": false
    },
    "assigned_aq_baseline_cases": {
      "type": "array",
      "maxItems": 0
    },
    "fixture_manifest": {
      "type": "string",
      "minLength": 1
    },
    "fixture_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "unimplemented",
              "implemented"
            ]
          },
          "kind": {
            "const": "runtime"
          },
          "result": {
            "type": "null"
          }
        },
        "required": [
          "id",
          "invariants",
          "status",
          "kind",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "store_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "enum": [
              "initialize",
              "open",
              "reject"
            ]
          },
          "unchanged_on_rejection": {
            "type": "boolean"
          },
          "status": {
            "const": "unimplemented"
          }
        },
        "required": [
          "id",
          "input",
          "expected",
          "unchanged_on_rejection",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "store_fixture": {
      "const": "conformance/wi-fabric-2/store-scenarios.json"
    },
    "store_fixture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "contract",
    "package_revision",
    "status",
    "upstream_target",
    "assigned_aq_baseline_cases",
    "fixture_manifest",
    "fixture_manifest_sha256",
    "cases",
    "store_scenarios",
    "store_fixture",
    "store_fixture_sha256"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
