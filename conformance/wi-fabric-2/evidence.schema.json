{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "runtime-conformance"
    },
    "phase": {
      "enum": [
        "candidate",
        "merged",
        "post-rebase"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "passed"
    },
    "consumer_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "upstream": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "AQ-CONT-1"
        },
        "implementation_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "git_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "conformance_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "contract",
        "implementation_commit",
        "git_tree",
        "archive_sha256",
        "source_tree_sha256",
        "conformance_revision"
      ],
      "additionalProperties": false
    },
    "upstream_build_receipt": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "source_record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixture_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "toolchain": {
      "type": "string",
      "minLength": 1
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "test_run_id": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "log": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "argv",
        "exit_code",
        "log"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "independent_review": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "reviewer",
        "receipt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "phase",
    "case_id",
    "status",
    "consumer_revision",
    "upstream",
    "upstream_build_receipt",
    "source_record_sha256",
    "fixture_manifest_sha256",
    "toolchain",
    "environment_sha256",
    "test_run_id",
    "command",
    "results",
    "independent_review"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
