      ]
    },
    {
      "id": "contract-check",
      "argv": [
        "cargo",
        "run",
        "--locked",
        "--manifest-path",
        "tools/wi-contract-check/Cargo.toml",
        "--",
        "all",
        "check"
      ],
      "definitionPaths": [
        ".cargo/config.toml",
        "fixtures/pre-wi-fabric-2/source/rust-toolchain.toml",
        "rust-toolchain.toml"
      ]
